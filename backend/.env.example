# Server
PORT=3000
NODE_ENV=development

# CORS — set to your Vercel frontend origin when available
CORS_ORIGIN=http://localhost:5173

# Database — matches docker-compose.yml defaults (host ports when running migrate on the host)
DATABASE_URL=postgresql://telos:telos@localhost:5432/telos

# Redis — matches docker-compose.yml defaults
REDIS_URL=redis://localhost:6379

# JWT (required for Auth)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Password reset
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# SMTP — wired but unused until configured (Commit 5)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@telos.local

# AI providers — not needed until Roadmap Phase 6/7. Type real keys directly
# here when that time comes — never paste them into chat.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Broker credential encryption (AES-256) — base64 of 32 random bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROKER_CREDENTIALS_KEY=

# Local Python MT5 connector (do not expose via Cloudflare Tunnel)
MT5_CONNECTOR_URL=http://127.0.0.1:3100

# Module 2 — Market Intelligence (08_Bot_Architecture.md Section 9.0/9.2).
# All optional; defaults shown.
# MARKET_INTELLIGENCE_TIMEFRAME=M15
# MARKET_INTELLIGENCE_BAR_COUNT=100
# MARKET_INTELLIGENCE_CACHE_TTL_SECONDS=20

# Module 3 — News & Sentiment Intelligence (08_Bot_Architecture.md
# Section 9.0/9.3). All optional; defaults shown.
# NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# NEWS_RSS_PRIMARY_URL=https://www.forexlive.com/feed/news
# NEWS_RSS_SECONDARY_URL=https://www.fxstreet.com/rss/news
# NEWS_SOURCE_TIMEOUT_MS=5000
# NEWS_INTELLIGENCE_CACHE_TTL_SECONDS=20
# NEWS_SEEN_HASH_TTL_SECONDS=86400
# NEWS_HEALTH_FAILURE_THRESHOLD=5
# NEWS_HEALTH_COOLDOWN_SECONDS=300
