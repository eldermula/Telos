# Server
PORT=3000
NODE_ENV=development

# CORS — set to your Vercel frontend origin when available
CORS_ORIGIN=http://localhost:5173

# Database (Commit 3)
# DATABASE_URL=postgresql://telos:telos@localhost:5432/telos

# Redis (Commit 5)
# REDIS_URL=redis://localhost:6379

# JWT (Commit 5)
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=24h

# Password reset (Commit 5)
# PASSWORD_RESET_TTL_SECONDS=3600
# PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# SMTP — wired but unused until configured (Commit 5)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@telos.local
