# Server
PORT=3000
NODE_ENV=development

# CORS — set to your Vercel frontend origin when available
CORS_ORIGIN=http://localhost:5173

# Database — matches docker-compose.yml defaults (host ports when running migrate on the host)
DATABASE_URL=postgresql://telos:telos@localhost:5432/telos

# Redis — matches docker-compose.yml defaults
REDIS_URL=redis://localhost:6379

# JWT (required for Auth)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Password reset
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# SMTP — wired but unused until configured (Commit 5)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@telos.local

# AI providers — not needed until Roadmap Phase 6/7. Type real keys directly
# here when that time comes — never paste them into chat.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Broker credential encryption (AES-256) — base64 of 32 random bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROKER_CREDENTIALS_KEY=

# Local Python MT5 connector (do not expose via Cloudflare Tunnel)
MT5_CONNECTOR_URL=http://127.0.0.1:3100

# Module 2 — Market Intelligence (08_Bot_Architecture.md Section 9.0/9.2).
# All optional; defaults shown.
# MARKET_INTELLIGENCE_TIMEFRAME=M15
# MARKET_INTELLIGENCE_BAR_COUNT=100
# MARKET_INTELLIGENCE_CACHE_TTL_SECONDS=20

# Module 3 — News & Sentiment Intelligence (08_Bot_Architecture.md
# Section 9.0/9.3). All optional; defaults shown.
# NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# NEWS_RSS_PRIMARY_URL=https://www.forexlive.com/feed/news
# NEWS_RSS_SECONDARY_URL=https://www.fxstreet.com/rss/news
# NEWS_SOURCE_TIMEOUT_MS=5000
# NEWS_INTELLIGENCE_CACHE_TTL_SECONDS=20
# NEWS_SEEN_HASH_TTL_SECONDS=86400
# NEWS_HEALTH_FAILURE_THRESHOLD=5
# NEWS_HEALTH_COOLDOWN_SECONDS=300
# Module 3 — real LLM classification (Claude). Kill switch OFF by default
# in every environment including production; exact-string "true" only.
# ANTHROPIC_API_KEY=   (already listed under AI providers above)
# NEWS_LLM_ENABLED=false
# NEWS_LLM_MODEL=claude-sonnet-4-6
# NEWS_LLM_MAX_TOKENS=2048
# NEWS_LLM_TIMEOUT_MS=20000
# Cost estimate rates ($ / million tokens) — used for usage logs + Redis counters
# NEWS_LLM_INPUT_USD_PER_MTOK=3
# NEWS_LLM_OUTPUT_USD_PER_MTOK=15
# Spend check (lifetime + UTC month): node backend/scripts/news-llm-usage.js
# Also exposed on admin GET /admin/system-health as news_llm.usage

# Crypto Increment B — parallel crypto news pipeline (BTC/ETH). Own kill
# switch; default OFF. Do not couple to NEWS_LLM_ENABLED.
# CRYPTO_NEWS_LLM_ENABLED=false
# CRYPTO_NEWS_RSS_PRIMARY_URL=https://cointelegraph.com/rss
# CRYPTO_NEWS_RSS_SECONDARY_URL=https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml
# CRYPTO_NEWS_SOURCE_TIMEOUT_MS=15000
# CRYPTO_NEWS_INTELLIGENCE_CACHE_TTL_SECONDS=20

# Phase 8.2 — encrypted Postgres backups (docs/OPS.md). Private backup repo
# is SEPARATE from this code repo. BACKUP_ENCRYPTION_KEY must be DISTINCT
# from BROKER_CREDENTIALS_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_KEY=
# BACKUP_REPO_DIR=C:\Users\USER\Desktop\Projects\telos-backups
# BACKUP_RETENTION_COUNT=14
# BACKUP_SKIP_PUSH=1

# Phase 8.5 — site-wide access gate (09_Security.md). REQUIRED in production.
# Phrase: Isaiah 43:18-19 NKJV (paste the verse text; normalization is server-side).
# Secret: distinct from JWT_SECRET — generate like BROKER_CREDENTIALS_KEY.
# ACCESS_GATE_PHRASE="Do not remember the former things, Nor consider the things of old. Behold, I will do a new thing, Now it shall spring forth; Shall you not know it? I will even make a road in the wilderness And rivers in the desert."
# ACCESS_GATE_SECRET=
# ACCESS_GATE_TTL_DAYS=30
# ACCESS_GATE_COOKIE_NAME=telos_gate

# Option 2 (real order placement) — Layer 1 deploy-level kill switch
# (docs/CHANGELOG.md). Must be the exact literal string "true" to enable;
# any other value (unset, "1", "True", etc.) resolves to disabled. Leave
# unset/false everywhere until Option 2 (Increment E) is fully built and
# verified.
# REAL_TRADING_ENABLED=true

# Synthetics real-dispatch Layer 1 — independent of REAL_TRADING_ENABLED.
# Exact-string "true" only; leave unset/false until synthetics real
# dispatch (Batch 2+) is verified.
# SYNTHETIC_REAL_TRADING_ENABLED=true

# Synthetics Layer 2 (confirm-live) and Layer 3 (demo-dispatch) bypasses
# are no longer env vars. Admins enable them independently via:
#   POST /admin/synthetic/demo-confirm-enable
#   POST /admin/synthetic/demo-dispatch-enable
# (DB-backed, auto-expires, max 30 minutes each).

# Synthetics manual test-dispatch/close — TESTING ONLY (admin toggle, not env):
#   POST /admin/synthetic/demo-manual-trade-enable
# Gates POST /bot/synthetic/test-dispatch-real and test-close-real.
# (DB-backed, auto-expires, max 30 minutes; same pattern as Layer 2/3.)

# Forex demo confirm / dispatch / manual test-trade — TESTING ONLY
# (admin toggles, not env; same pattern as synthetics above):
#   POST /admin/forex/demo-confirm-enable
#   POST /admin/forex/demo-dispatch-enable
#   POST /admin/forex/demo-manual-trade-enable
# (DB-backed, auto-expires, max 30 minutes each). REAL_TRADING_ENABLED
# remains the deploy-level kill switch and is unchanged.

# Option 2 E.3 — real-order hard lot ceiling and connection freshness.
# Default in env.js is 1.00 (below Deriv volume_max 20 FX / 10 XAU).
# REAL_MAX_LOT=1
# REAL_CONNECTION_MAX_AGE_HOURS=24
